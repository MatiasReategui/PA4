# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a GitHub.

# Secreto con el que se firma el JWT (mínimo 32 caracteres, aleatorio)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-123456
# Tiempo de vida del token (formato de jsonwebtoken: 15m, 2h, 1d)
JWT_EXPIRES_IN=2h

# Nivel mínimo de logs: debug | info | warn | error
LOG_LEVEL=info

# Variables visibles en el navegador (prefijo NEXT_PUBLIC_)
NEXT_PUBLIC_APP_NAME=Gestión de Solicitudes Académicas
# Vacío = misma origen (usa las rutas /api de este proyecto)
NEXT_PUBLIC_API_URL=
